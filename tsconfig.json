
{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node",
            "mocha"
        ],
        "sourceMap": true,
        "rootDir": "src",
        "strict": true,
        /* Additional Checks */
        // "noImplicitReturns": true,
        // "noFallthroughCasesInSwitch": true,
        // "noUnusedParameters": true
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "backups",
        "out",
        "dist"
    ]
}
